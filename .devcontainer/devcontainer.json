{
  "name": "SentinelAI (testbed + backend)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin",
    "TB_MIN_AVAILABLE_MB": "1024"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8081, 8089, 9090, 3100, 16686, 3001, 3000, 8000],
  "portsAttributes": {
    "8081": { "label": "Testbed shop (frontend)", "onAutoForward": "silent" },
    "8089": { "label": "Testbed load generator API", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" },
    "3100": { "label": "Loki", "onAutoForward": "silent" },
    "16686": { "label": "Jaeger UI", "onAutoForward": "silent" },
    "3001": { "label": "Grafana (make testbed-ui)", "onAutoForward": "silent" },
    "3000": { "label": "SentinelAI frontend", "onAutoForward": "silent" },
    "8000": { "label": "SentinelAI API", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
