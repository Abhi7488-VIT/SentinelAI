# Copy to .env and change every "change-me" value before running anything shared.
# Every variable read by the backend Settings or docker-compose.yml must appear here
# (enforced by backend/tests/unit/test_env_example.py).
# Passwords are embedded in URLs below: use URL-safe characters (letters, digits, - _ .).
# Host-side URLs use 127.0.0.1, not localhost: on Windows+WSL2, localhost resolves to ::1 first
# and WSL only forwards IPv4, so every connection would first stall on a refused IPv6 attempt.

# ---- runtime ----
ENV=dev
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sentinel
# Used by the backend when run on the host (dev/test). Compose overrides the host to "postgres".
DATABASE_URL=postgresql+asyncpg://sentinel:change-me-postgres@127.0.0.1:5432/sentinel
# Integration tests use a separate database (created by infrastructure/postgres/init).
TEST_DATABASE_URL=postgresql+asyncpg://sentinel:change-me-postgres@127.0.0.1:5432/sentinel_test
# Pool / timeouts
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=5000

# ---- Redis ----
REDIS_PASSWORD=change-me-redis
# db 0: app (rate limiting), db 1: Celery broker, db 2: Celery results, db 15: tests
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:change-me-redis@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis@127.0.0.1:6379/2
TEST_REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/15

# ---- Auth ----
# At least 32 bytes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_ISSUER=sentinelai
JWT_AUDIENCE=sentinelai-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_FAMILY_TTL_SECONDS=2592000
# Must be true when ENV=prod (HTTPS).
COOKIE_SECURE=false
# Max auth attempts (register/login/refresh) per window, per client IP and per email.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Telemetry storage (ADR 0005) ----
# Daily partitions, created ahead and dropped after retention by the maintenance job.
TELEMETRY_RETENTION_SPANS_DAYS=3
TELEMETRY_RETENTION_LOGS_DAYS=3
TELEMETRY_RETENTION_METRICS_DAYS=7
TELEMETRY_PARTITION_DAYS_AHEAD=2
INGEST_USAGE_RETENTION_DAYS=30

# ---- OTLP ingestion (ingest process) ----
# Request size caps (compressed body / after gzip), records per request, per-key rates (per second).
INGEST_MAX_BODY_BYTES=4194304
INGEST_MAX_DECOMPRESSED_BYTES=16777216
INGEST_MAX_RECORDS_PER_REQUEST=10000
INGEST_RATE_REQUESTS_PER_SECOND=50
INGEST_RATE_RECORDS_PER_SECOND=20000
# Accepted record timestamps: from now - MAX_AGE to now + MAX_FUTURE (seconds).
INGEST_MAX_AGE_SECONDS=7200
INGEST_MAX_FUTURE_SECONDS=300
# Revoked keys stop working within this many seconds (in-process key cache).
INGEST_KEY_CACHE_SECONDS=10
# Bounded queue to the writer: max pending batches and max size of one normalized batch.
INGEST_QUEUE_MAX_PENDING=100
INGEST_QUEUE_MAX_MESSAGE_BYTES=2097152
# Writer: max metric series per service (new ones beyond are dropped + counted); dead-letter cap.
INGEST_MAX_SERIES_PER_SERVICE=2000
INGEST_DEAD_LETTER_MAX=1000

# ---- HTTP ----
# JSON list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend ----
# Baked into the frontend bundle at build time; the URL the *browser* uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
