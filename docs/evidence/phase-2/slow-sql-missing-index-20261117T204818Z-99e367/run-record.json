{
  "schema_version": 1,
  "kind": "run",
  "id": "slow-sql-missing-index",
  "number": 2,
  "title": "Slow order-history query after its indexes are dropped",
  "injected_fault": {
    "trigger": "SQL change drop-order-history-indexes",
    "description": "A schema change drops ix_orders_user_id_created_at and ix_orders_created_at on the 500k-row orders table. GET /orders (a user's newest orders) has no index left to use, so every order-history lookup scans the table, and the account page that shows it slows down with it. Nothing errors.",
    "stop": "CREATE both indexes again"
  },
  "root_cause": {
    "category": "slow_query",
    "service": "order-service",
    "component": "orders table: missing indexes ix_orders_user_id_created_at (user_id, created_at DESC) and ix_orders_created_at (created_at)",
    "summary": "The order-history query filters orders by user_id and sorts by created_at; with neither the composite index nor the created_at index it scans the 500k-row table on every request, so GET /orders p95 latency rises by orders of magnitude and the frontend account page slows with it. No errors are returned.",
    "code_location": {
      "path": "services/shop/order_service/db.py",
      "symbol": "ix_orders_user_id_created_at"
    }
  },
  "expected_symptoms": [
    {
      "id": "orders-p95-slow",
      "signal": "metric",
      "backend": "prometheus",
      "description": "order-service GET /orders p95 latency at least 5x this run's baseline p95 (floor 50 ms), for 2 minutes.",
      "query": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"order-service\", http_route=\"/orders\", http_request_method=\"GET\"}[1m])))",
      "condition": {
        "op": ">",
        "threshold": 5,
        "relative_to_baseline": true,
        "min_value": 0.05,
        "min_points": 8
      }
    },
    {
      "id": "account-p95-slow",
      "signal": "metric",
      "backend": "prometheus",
      "description": "The user-facing account page (frontend GET /account) p95 at least 3x its baseline (floor 50 ms), for 2 minutes.",
      "query": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"frontend\", http_route=\"/account\", http_request_method=\"GET\"}[1m])))",
      "condition": {
        "op": ">",
        "threshold": 3,
        "relative_to_baseline": true,
        "min_value": 0.05,
        "min_points": 8
      }
    },
    {
      "id": "orders-slow-select-spans",
      "signal": "trace",
      "backend": "jaeger",
      "description": "order-service SELECT spans of 500 ms or more: the order-history table scan (measured live with EXPLAIN ANALYZE: ~1.6 s warm without the index vs ~48 ms cold with it on the 152 MB table).",
      "query": {
        "service": "order-service",
        "operation": "SELECT",
        "min_duration_ms": 500
      },
      "condition": {
        "op": ">=",
        "threshold": 5
