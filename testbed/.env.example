# Testbed configuration. `make testbed-up` creates testbed/.env from this file with random
# secrets if it does not exist. Every variable docker-compose.yml reads must be listed here
# (enforced by tests/unit/test_compose.py). Values must be URL-safe (letters, digits, - _ .).

# ---- Postgres (superuser: used only by the harness for schema changes) ----
POSTGRES_PASSWORD=change-me-postgres
# Per-service database roles
USERS_DB_PASSWORD=change-me-users-db
ORDERS_DB_PASSWORD=change-me-orders-db
PAYMENTS_DB_PASSWORD=change-me-payments-db

# ---- Redis (user-service sessions) ----
REDIS_PASSWORD=change-me-redis

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Determinism ----
# Seeds the data generator, payment-issuer decisions and (T5) the load generator.
SEED=42
# Historical orders loaded on first start (scenario 2 needs a few hundred thousand).
SEED_ORDERS=500000

# ---- Telemetry ----
# Collector debug exporter: basic (counts only) | normal | detailed
COLLECTOR_DEBUG_VERBOSITY=basic
# SentinelAI OTLP/HTTP ingest (Phase 3). Empty = not exported.
SENTINELAI_OTLP_ENDPOINT=

# ---- Grafana (profile `ui`, off by default) ----
GRAFANA_ADMIN_PASSWORD=change-me-grafana
